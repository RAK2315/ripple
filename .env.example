# Primary model provider (Groq free tier). console.groq.com, keys start with "gsk_"
GROQ_API_KEY=

# Fallback model provider (Google Gemini): used only when a Groq call fails (quota, rate limit, error).
# https://aistudio.google.com/apikey  (starts with "AIza")
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=

# ElevenLabs, for the demo video voiceover only (not used by the app)
ELEVENLABS_API_KEY=
